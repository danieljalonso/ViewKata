<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="46dp"
    android:background="@color/black">
    
    <RelativeLayout
        android:id="@+id/red_block1"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:background="@drawable/red_block"/>

    <RelativeLayout
        android:id="@+id/white_block1"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/red_block1"
        android:layout_alignParentBottom="true"
        android:background="@drawable/white_block"/>

    <RelativeLayout
        android:id="@+id/pink_block1"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/white_block1"
        android:layout_alignParentBottom="true"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/yellow_block1"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block1"
        android:layout_alignParentBottom="true"
        android:background="@drawable/yellow_block"/>

    <RelativeLayout
        android:id="@+id/white_block2"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/yellow_block1"
        android:layout_marginStart="@dimen/box_size"
        android:layout_alignParentBottom="true"
        android:background="@drawable/white_block"/>

    <RelativeLayout
        android:id="@+id/pink_block2"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/white_block2"
        android:layout_alignParentBottom="true"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block3"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block2"
        android:layout_alignParentBottom="true"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block4"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block3"
        android:layout_alignParentBottom="true"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block5"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block4"
        android:layout_alignParentBottom="true"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/purple_block1"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_alignParentStart="true"
        android:layout_above="@id/red_block1"
        android:background="@drawable/purple_block"/>

    <RelativeLayout
        android:id="@+id/pink_block6"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/purple_block1"
        android:layout_above="@id/red_block1"
        android:layout_marginStart="@dimen/box_size"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block7"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block6"
        android:layout_above="@id/red_block1"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/red_block2"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block7"
        android:layout_above="@id/red_block1"
        android:background="@drawable/red_block"/>

    <RelativeLayout
        android:id="@+id/yellow_block2"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/red_block2"
        android:layout_above="@id/red_block1"
        android:background="@drawable/yellow_block"/>

    <RelativeLayout
        android:id="@+id/yellow_block3"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/yellow_block2"
        android:layout_above="@id/red_block1"
        android:background="@drawable/yellow_block"/>

    <RelativeLayout
        android:id="@+id/red_block3"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/yellow_block3"
        android:layout_above="@id/red_block1"
        android:background="@drawable/red_block"/>

    <RelativeLayout
        android:id="@+id/pink_block8"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/red_block3"
        android:layout_above="@id/red_block1"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block9"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block8"
        android:layout_above="@id/red_block1"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block10"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_alignParentStart="true"
        android:layout_above="@id/purple_block1"
        android:layout_marginStart="96dp"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/red_block4"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block10"
        android:layout_above="@id/purple_block1"
        android:background="@drawable/red_block"/>

    <RelativeLayout
        android:id="@+id/yellow_block4"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/red_block4"
        android:layout_above="@id/purple_block1"
        android:background="@drawable/yellow_block"/>

    <RelativeLayout
        android:id="@+id/pink_block11"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/yellow_block4"
        android:layout_above="@id/purple_block1"
        android:layout_marginStart="64dp"
        android:background="@drawable/pink_block"/>

    <RelativeLayout
        android:id="@+id/pink_block12"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:layout_toEndOf="@id/pink_block11"
        android:layout_above="@id/purple_block1"
        android:background="@drawable/pink_block"/>

</RelativeLayout>