<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/label_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_name"/>

    <TextView
        android:id="@+id/label_surname1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/label_name"
        android:text="@string/rl_label_surname1"/>

    <TextView
        android:id="@+id/label_surname2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/label_surname1"
        android:text="@string/rl_label_surname2"/>

    <TextView
        android:id="@+id/age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="@string/age"/>



    <TextView
        android:id="@+id/label_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/label_name"
        android:text="@string/address"/>

    <TextView
        android:id="@+id/label_2nd_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/label_surname2"
        android:layout_toEndOf="@id/label_surname1"
        android:text="@string/_2nd_block"/>

    <TextView
        android:id="@+id/label_phonenumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/age"
        android:layout_alignParentEnd="true"
        android:text="@string/phone"/>


</RelativeLayout>